# API base URL. Empty = relative URLs, Vite proxy forwards /api to backend.
# Prod: VITE_API_BASE_URL=https://api.alugra.co.id
# VITE_API_BASE_URL=

# Backend URL for Vite proxy (when VITE_API_BASE_URL is empty).
# If backend runs on 6000: VITE_PROXY_TARGET=http://localhost:6000
# VITE_PROXY_TARGET=http://localhost:3000
